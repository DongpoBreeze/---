{
  "name": "health-compass",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "node --dns-result-order=ipv4first node_modules/expo/bin/cli start --web --localhost --port 8081 --max-workers 2",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --max-workers 2",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:server": "node --test server/*.test.mjs",
    "test:scripts": "node --import tsx --test --test-timeout=30000 scripts/*.test.mjs",
    "test:ui": "playwright test",
    "server": "node server/index.mjs",
    "server:codex": "node server/start-local-codex.mjs",
    "web:codex": "node scripts/start-local-preview.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "eventsource-parser": "^4.1.1",
    "expo": "~57.0.27",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "jszip": "^3.10.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "smol-toml": "^1.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
