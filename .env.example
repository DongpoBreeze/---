# Development only. Never put a model-provider API key in EXPO_PUBLIC variables.
EXPO_PUBLIC_AI_GATEWAY_URL=http://127.0.0.1:8787
EXPO_PUBLIC_AI_ACCESS_TOKEN=

# Server-side configuration. Keep actual values in a separate server env file or the host environment.
SERVER_ACCESS_TOKEN=
MODEL_API_URL=
MODEL_API_PROTOCOL=responses
MODEL_API_KEY=
MODEL_NAME=
MODEL_REASONING_EFFORT=
MODEL_MAX_OUTPUT_TOKENS=8192
MAX_REQUEST_COST_CNY=
MONTHLY_BUDGET_CNY=300
FIXED_MONTHLY_COST_CNY=0
NON_AI_MONTHLY_COST_CNY=0
SAFETY_RESERVE_CNY=30
INSTALLATION_DAILY_QUOTA=5
