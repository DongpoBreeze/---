{
  "expo": {
    "name": "Health Compass",
    "slug": "health-compass",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8F7F5",
    "splash": {
      "backgroundColor": "#F8F7F5"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F8F7F5"
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F8F7F5"
    },
    "scheme": "healthcompass",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.healthcompass.app",
      "infoPlist": {
        "NSCameraUsageDescription": "用于拍摄餐食照片，帮助你记录饮食。",
        "NSPhotoLibraryUsageDescription": "用于选择餐食照片或训练视频。"
      }
    },
    "android": {
      "package": "com.healthcompass.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#F8F7F5"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-image-picker",
      "expo-document-picker",
      "expo-sharing",
      "expo-status-bar",
      "expo-system-ui",
      "expo-video",
      "expo-secure-store"
    ]
  }
}
